# Two local positions occupied at block end both fire their Destructors.
# Both particles are automatically destroyed, triggering destructor_a and destructor_b.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box_a> {
            it may only contain particles where {
                it has the action</destructor_a>.
            }
        }
        define the position<box_b> {
            it may only contain particles where {
                it has the action</destructor_b>.
            }
        }
        create a particle in position<box_a>.
        create a particle in position<box_b>.
    }
}
